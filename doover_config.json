{
    "ubiquiti_airmax": {
        "name": "ubiquiti_airmax",
        "display_name": "Ubiquiti AirMax",
        "type": "DEV",
        "visibility": "PUB",
        "allow_many": true,
        "description": "Live telemetry and autonomous config for a Ubiquiti airMAX radio",
        "long_description": "README.md",
        "depends_on": [],
        "image_name": "registry.doover.com/apps/ubiquiti_airmax:main",
        "build_args": "--platform linux/amd64,linux/arm64",
        "export_config_command": "export-config-airmax",
        "export_ui_command": "export-ui-airmax",
        "run_command": "doover-app-run-airmax",
        "lambda_config": {},
        "key": "5b928db3-cb2e-49a7-b7da-9d4d98da3350",
        "organisation_id": null,
        "icon_url": "https://cdn11.bigcommerce.com/s-qfsa541khk/images/stencil/250w/i/ubiquiti_1686844765__27928.original.png",
        "config_schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "",
            "title": "$default",
            "type": "object",
            "properties": {
                "mac": {
                    "title": "MAC Address",
                    "x-name": "mac",
                    "x-hidden": false,
                    "type": "string",
                    "x-required": true,
                    "description": "The radio this install manages. Accepts 04:18:D6:AA:BB:CC, 04-18-d6-aa-bb-cc or 0418d6aabbcc. Run 'airos discover' to find it \u2014 the number on the device label is a serial, not a MAC.",
                    "x-position": 0
                },
                "expected_model": {
                    "title": "Expected Model",
                    "x-name": "expected_model",
                    "x-hidden": false,
                    "type": [
                        "string",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Optional. Provisioning is refused unless the discovered model contains this string \u2014 a guard against a MAC typo hitting a real radio.",
                    "default": "",
                    "x-position": 1
                },
                "platform": {
                    "enum": [
                        "any",
                        "XM",
                        "XW",
                        "TI",
                        "XN",
                        "XC",
                        "WA"
                    ],
                    "title": "Platform",
                    "x-name": "platform",
                    "x-hidden": false,
                    "type": [
                        "string",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Hardware platform the overrides are written for, from the firmware string. XM/XW/TI/XN are airMAX M (airOS 6); XC/WA are airMAX AC (airOS 8). A radio whose platform disagrees is refused rather than pushed to \u2014 the same model name ships as different platforms.",
                    "default": "any",
                    "x-position": 2
                },
                "overrides": {
                    "title": "Config Overrides",
                    "x-name": "overrides",
                    "x-hidden": false,
                    "type": [
                        "array",
                        "null"
                    ],
                    "x-required": false,
                    "description": "The airOS keys to set. Everything else on the radio is left alone. Leave empty to run as telemetry-only, with no config changes at all.",
                    "default": [],
                    "x-position": 3,
                    "items": {
                        "title": "Override",
                        "x-name": "override",
                        "x-hidden": false,
                        "type": "object",
                        "x-required": true,
                        "properties": {
                            "key": {
                                "title": "Key",
                                "x-name": "key",
                                "x-hidden": false,
                                "type": "string",
                                "x-required": true,
                                "description": "airOS config key, e.g. 'radio.1.freq' or 'netconf.1.ip'. Dotted and 1-indexed where it represents a list.",
                                "x-position": 1
                            },
                            "value": {
                                "title": "Value",
                                "x-name": "value",
                                "x-hidden": false,
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "x-required": false,
                                "description": "Literal value, or Jinja2 referencing a variable, e.g. '{{ ssid }}'.",
                                "default": "",
                                "x-position": 2
                            }
                        },
                        "additionalElements": true,
                        "required": [
                            "key"
                        ],
                        "x-collapsible": true,
                        "x-defaultCollapsed": false
                    }
                },
                "variables": {
                    "title": "Template Variables",
                    "x-name": "variables",
                    "x-hidden": false,
                    "type": [
                        "object",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Free-form key/value pairs available to the overrides as Jinja2 variables.",
                    "default": {},
                    "x-position": 4,
                    "properties": {},
                    "additionalElements": true,
                    "required": [],
                    "x-collapsible": true,
                    "x-defaultCollapsed": false
                },
                "dry_run": {
                    "title": "Dry Run",
                    "x-name": "dry_run",
                    "x-hidden": false,
                    "type": [
                        "boolean",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Report the diff but never write to the radio. Telemetry still works. Leave on until you have watched it produce a correct diff.",
                    "default": true,
                    "x-position": 5
                },
                "max_attempts": {
                    "title": "Max Attempts",
                    "x-name": "max_attempts",
                    "x-hidden": false,
                    "type": [
                        "integer",
                        "null"
                    ],
                    "x-required": false,
                    "description": "After this many failed pushes the radio is parked and left alone. This is what stops a config that never converges becoming a reboot loop.",
                    "default": 3,
                    "x-position": 6,
                    "minimum": 1,
                    "maximum": 20
                },
                "retry_backoff": {
                    "title": "Retry Backoff (s)",
                    "x-name": "retry_backoff",
                    "x-hidden": false,
                    "type": [
                        "integer",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Minimum wait before retrying after a failed attempt.",
                    "default": 300,
                    "x-position": 7,
                    "minimum": 10
                },
                "failed_retry_after": {
                    "title": "Failed Retry After (s)",
                    "x-name": "failed_retry_after",
                    "x-hidden": false,
                    "type": [
                        "integer",
                        "null"
                    ],
                    "x-required": false,
                    "description": "How long a parked radio waits before trying again, so a transient failure heals itself. 0 means never retry. Editing the overrides or variables also clears a parked radio immediately.",
                    "default": 3600,
                    "x-position": 8,
                    "minimum": 0
                },
                "interface": {
                    "title": "Provisioning Interface",
                    "x-name": "interface",
                    "x-hidden": false,
                    "type": [
                        "string",
                        "null"
                    ],
                    "x-required": false,
                    "description": "LAN interface to discover and provision on. MUST NOT be the interface carrying this device's default route \u2014 the app refuses to start if it is.",
                    "default": "eth0",
                    "x-position": 9
                },
                "manage_addresses": {
                    "title": "Manage Interface Addresses",
                    "x-name": "manage_addresses",
                    "x-hidden": false,
                    "type": [
                        "boolean",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Temporarily add a secondary address so a factory radio on 192.168.1.20 is reachable from another subnet. Needs NET_ADMIN. Removed again after each attempt.",
                    "default": true,
                    "x-position": 10
                },
                "poll_interval": {
                    "title": "Poll Interval (s)",
                    "x-name": "poll_interval",
                    "x-hidden": false,
                    "type": [
                        "integer",
                        "null"
                    ],
                    "x-required": false,
                    "description": "How often to sweep for the radio and read its telemetry. Also the resolution of the graphs in the UI.",
                    "default": 30,
                    "x-position": 11,
                    "minimum": 5
                },
                "discovery_timeout": {
                    "title": "Discovery Timeout (s)",
                    "x-name": "discovery_timeout",
                    "x-hidden": false,
                    "type": [
                        "number",
                        "null"
                    ],
                    "x-required": false,
                    "description": "How long to listen for discovery replies each sweep.",
                    "default": 3.0,
                    "x-position": 12
                },
                "reboot_wait": {
                    "title": "Reboot Wait (s)",
                    "x-name": "reboot_wait",
                    "x-hidden": false,
                    "type": [
                        "integer",
                        "null"
                    ],
                    "x-required": false,
                    "description": "How long to wait for the radio to come back after a reboot before verifying. It returns on its NEW address, which discovery re-finds.",
                    "default": 120,
                    "x-position": 13,
                    "minimum": 30
                },
                "ssh_port": {
                    "title": "SSH Port",
                    "x-name": "ssh_port",
                    "x-hidden": false,
                    "type": [
                        "integer",
                        "null"
                    ],
                    "x-required": false,
                    "default": 22,
                    "x-position": 14
                },
                "credentials": {
                    "title": "Credentials",
                    "x-name": "credentials",
                    "x-hidden": false,
                    "type": [
                        "array",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Tried in order until one authenticates.",
                    "default": [
                        {
                            "username": "ubnt",
                            "password": "ubnt",
                            "label": "factory default"
                        }
                    ],
                    "x-position": 15,
                    "items": {
                        "title": "Credential",
                        "x-name": "credential",
                        "x-hidden": false,
                        "type": "object",
                        "x-required": true,
                        "properties": {
                            "username": {
                                "title": "Username",
                                "x-name": "username",
                                "x-hidden": false,
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "x-required": false,
                                "default": "ubnt",
                                "x-position": 1
                            },
                            "password": {
                                "title": "Password",
                                "x-name": "password",
                                "x-hidden": false,
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "x-required": false,
                                "default": "ubnt",
                                "x-position": 2
                            },
                            "label": {
                                "title": "Label",
                                "x-name": "label",
                                "x-hidden": false,
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "x-required": false,
                                "description": "Optional note, e.g. 'factory default' or 'site standard'.",
                                "default": "",
                                "x-position": 3
                            }
                        },
                        "additionalElements": true,
                        "required": [],
                        "x-collapsible": true,
                        "x-defaultCollapsed": false
                    }
                },
                "verify_exclude": {
                    "title": "Verify Exclude Keys",
                    "x-name": "verify_exclude",
                    "x-hidden": false,
                    "type": [
                        "array",
                        "null"
                    ],
                    "x-required": false,
                    "description": "fnmatch patterns for keys that are pushed but not verified, because the radio rewrites them (password hashes, obscured PSKs).",
                    "default": [
                        "users.*.password",
                        "*.psk",
                        "*.wpa.psk",
                        "*.key",
                        "snmp.*.community"
                    ],
                    "x-position": 16,
                    "items": {
                        "title": "Key Pattern",
                        "x-name": "pattern",
                        "x-hidden": false,
                        "type": "string",
                        "x-required": true
                    }
                }
            },
            "additionalElements": true,
            "required": [
                "mac"
            ]
        },
