                        "snr": {
                            "name": "snr",
                            "displayString": "SNR",
                            "dataType": "unknown",
                            "lookup": "$tag.app().snr:number:null",
                            "active": true,
                            "colour": "green",
                            "units": "dB",
                            "live": true
                        },
                        "signal": {
                            "name": "signal",
                            "displayString": "Signal",
                            "dataType": "unknown",
                            "lookup": "$tag.app().signal:number:null",
                            "active": true,
                            "colour": "blue",
                            "units": "dBm",
                            "live": true
                        },
                        "noise_floor": {
                            "name": "noise_floor",
                            "displayString": "Noise Floor",
                            "dataType": "unknown",
                            "lookup": "$tag.app().noise_floor:number:null",
                            "active": false,
                            "colour": "grey",
                            "units": "dBm",
                            "live": true
                        },
                        "airmax_ccq": {
                            "name": "airmax_ccq",
                            "displayString": "airMAX CCQ",
                            "dataType": "unknown",
                            "lookup": "$tag.app().ccq:number:null",
                            "active": false,
                            "colour": "orange",
                            "sharedAxis": false,
                            "units": "%",
                            "live": true
                        },
                        "rx_throughput": {
                            "name": "rx_throughput",
                            "displayString": "RX Throughput",
                            "dataType": "unknown",
                            "lookup": "$tag.app().rx_throughput:number:null",
                            "active": false,
                            "colour": "purple",
                            "sharedAxis": false,
                            "units": "kbps",
                            "live": true
                        },
                        "device_connected": {
                            "name": "device_connected",
                            "displayString": "Device Connected",
                            "dataType": "boolean",
                            "lookup": "$tag.app().online:boolean:false",
                            "active": true,
                            "colour": "limegreen",
                            "sharedAxis": false,
                            "live": true
                        }
                    },
                    "title": "Link History"
                },
                "online": {
                    "name": "online",
                    "type": "uiVariable",
                    "displayString": "Device Connected",
                    "showActivity": true,
                    "position": 1,
                    "hidden": false,
                    "varType": "bool",
                    "currentValue": "$tag.app().online:boolean:false",
                    "live": true
                },
                "snr": {
                    "name": "snr",
                    "type": "uiVariable",
                    "displayString": "Signal / Noise",
                    "showActivity": true,
                    "form": "radialGauge",
                    "position": 2,
                    "hidden": false,
                    "units": "dB",
                    "varType": "float",
                    "currentValue": "$tag.app().snr:number:null",
                    "decPrecision": 0,
                    "ranges": [
                        {
                            "min": 0,
                            "max": 10,
                            "colour": "red",
                            "show_on_graph": true,
                            "label": "Unusable"
                        },
                        {
                            "min": 10,
                            "max": 20,
                            "colour": "yellow",
                            "show_on_graph": true,
                            "label": "Marginal"
                        },
                        {
                            "min": 20,
                            "max": 30,
                            "colour": "blue",
                            "show_on_graph": true,
                            "label": "Good"
                        },
                        {
                            "min": 30,
                            "max": 60,
                            "colour": "green",
                            "show_on_graph": true,
                            "label": "Excellent"
                        }
                    ],
                    "live": true
                },
