                    "name": "unreachable_warning",
                    "type": "uiWarningIndicator",
                    "displayString": "Radio not reachable",
                    "position": 20,
                    "hidden": "$tag.app().reachable_ok:boolean:true",
                    "currentValue": "$cmds.app().unreachable_warning",
                    "can_cancel": true
